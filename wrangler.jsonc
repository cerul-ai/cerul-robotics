{
  // Static website for https://robotics.cerul.ai. Assets only: no Worker
  // script runs, Cloudflare serves site/ directly. See site/README.md.
  "$schema": "https://unpkg.com/wrangler@4.136.0/config-schema.json",
  "name": "cerul-robotics-site",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./site",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "robotics.cerul.ai", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
